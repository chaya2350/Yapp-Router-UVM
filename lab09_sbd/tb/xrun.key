run
probe -create -shm $uvm:{uvm_test_top.tb.router_env.sb}.router_en $uvm:{uvm_test_top.tb.router_env.sb}.max_pkt_size
reset
run
probe -create -shm hw_top.clk_rst_if.clock hw_top.clk_rst_if.clock_cycle_count_reached hw_top.clk_rst_if.clock_cycles_to_count hw_top.clk_rst_if.clock_period hw_top.clk_rst_if.reset hw_top.clk_rst_if.reset_delay hw_top.clk_rst_if.run_clock
reset
run
scope -set hw_top.clk_rst_if
probe -create -shm $uvm:{uvm_test_top.tb.router_env.sb} -depth all -all
reset
run
reset
probe -create -shm $uvm:{uvm_test_top.tb.router_env.sb} -depth all -all
run
exit
